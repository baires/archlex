{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "**",
      "!**/.claude/skills",
      "!**/.gemini",
      "!**/.github/skills",
      "!**/.opencode/skills",
      "!**/.turbo",
      "!**/.next",
      "!**/.astro",
      "!**/.wrangler",
      "!**/apps/mcp-server/src/generated",
      "!**/out",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!**/*.svg",
      "!pnpm-lock.yaml"
    ]
  },
  "overrides": [
    {
      "includes": ["**/package.json"],
      "json": {
        "formatter": {
          "expand": "auto"
        }
      }
    },
    {
      "includes": [
        "docs/errors/index.md",
        "docs/errors/AL-*.md",
        "docs/guides/relationship-types.md",
        ".agents/skills/archlex/SKILL.md",
        "apps/landing/public/.well-known/agent-skills/archlex/SKILL.md"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
