+// Zod 4 removed ZodObject.deepPartial(). Nextra 3 builds its config schemas
+// with that helper; recreate it so the docs app can run on the patched Zod.
+function deepPartial(schema) {
+  if (schema?.type === "object") {
+    const shape = {};
+    for (const key of Object.keys(schema.shape)) {
+      shape[key] = deepPartial(schema.shape[key]).optional();
+    }
+    return schema.def?.catchall?.type === "never" ? z.strictObject(shape) : z.object(shape);
+  }
+  if (schema?.type === "union") {
+    return z.union(schema.options.map((option) => deepPartial(option)));
+  }
+  if (schema?.type === "array") {
+    return z.array(deepPartial(schema.element));
+  }
+  if (schema?.type === "optional") {
+    return deepPartial(schema.unwrap()).optional();
+  }
+  if (schema?.type === "nullable") {
+    return deepPartial(schema.unwrap()).nullable();
+  }
+  return schema;
+}
