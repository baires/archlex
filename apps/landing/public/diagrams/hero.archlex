direction LR
provider aws
validation normal

account enterprise-cloud {
  region us-east-1 {
    dns: route53["Route 53"]
    cdn: cloudfront["CloudFront"]
    events: eventbridge["EventBridge"]

    dns -[routes]-> cdn

    vpc production-vpc {
      subnet public-tier {
        gateway: api-gateway["API Gateway"]
        ingress: alb["Load Balancer"]
      }

      subnet application-tier {
        api_service: ecs["API Cluster"]
        worker: lambda["Event Worker"]
      }

      subnet data-tier {
        cache: elasticache["Redis Cache"]
        database: aurora["Aurora PostgreSQL"]
        lake: s3["Data Lake"]
      }
    }

    cdn -[routes]-> gateway -[invokes]-> api_service
    cdn -[routes]-> ingress -[routes]-> api_service

    api_service -[caches]-> cache
    api_service -[writes]-> database
    api_service -[publishes]-> events

    events -[triggers]-> worker
    worker -[streams]-> lake
  }
}
