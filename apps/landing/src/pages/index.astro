---
import Button from "../components/Button.astro";
import GetStarted from "../components/GetStarted.astro";
import MulticloudStage from "../components/MulticloudStage.astro";
import ReviewBench from "../components/ReviewBench.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_ROUTES } from "../config";
import {
  exampleUrl,
  faqs,
  multicloudSource,
  providers,
  reviewSources,
} from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout title="ArchLex: Multicloud diagrams for LLMs and MCP" description="Free hosted MCP for cloud architecture diagrams. Let your agent draw AWS, Cloudflare, GCP and Kubernetes, then edit in the playground. No API keys or account.">
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <section class="review-hero shell" aria-labelledby="hero-title">
      <div class="review-hero__copy">
        <p class="hero-context">Built for LLMs and MCP</p>
        <h1 id="hero-title">Cloud diagrams.<br /> Built for agents.</h1>
      </div>
      <div class="review-hero__intro">
        <p class="review-hero__lede">Ask Claude, Cursor or Codex to map AWS, Cloudflare, GCP and Kubernetes. Get checked source, a rendered diagram and a link to keep editing in the playground.</p>
        <div class="hero-actions">
          <Button href="#get-started">Connect free MCP <span aria-hidden="true">↓</span></Button>
          <a class="text-link" href={exampleUrl(multicloudSource)}>Open playground <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-note">Free to use. No API keys or account required.</p>
      </div>
      <div class="review-hero__stage"><MulticloudStage /></div>
      <ol class="agent-workflow" aria-label="From your LLM to your workspace">
        <li><h2>Ask your LLM.</h2><p>Describe your system. The agent skill supplies the language, provider rules and examples.</p></li>
        <li><h2>Let MCP do the checking.</h2><p>Cloud catalogs, validation and rendering, with tools, prompts and documentation ready for your agent.</p></li>
        <li><h2>Make it yours.</h2><p>Open the same source in the playground. Inspect, edit and export your architecture.</p></li>
      </ol>
    </section>

    <GetStarted />

    <section class="validation-section shell" id="architecture-review" aria-labelledby="validation-title">
      <div class="validation-section__copy">
        <h2 id="validation-title">Your agent writes it.<br /> ArchLex checks it.</h2>
        <p>Resources have an identity. Connections have rules. Give your agent a language that understands both.</p>
        <p>Try this AWS example: change a supported connection, inspect the real provider warning, then correct it.</p>
        <a class="text-link" href={SITE_ROUTES.agentsDocs}>Explore the agent workflow <span aria-hidden="true">↗</span></a>
      </div>
      <ReviewBench />
    </section>

    <section class="meaning-section shell" aria-labelledby="meaning-title">
      <div class="meaning-section__statement">
        <h2 id="meaning-title">Every connection<br />has a meaning.</h2>
        <p>A line is easy to draw. ArchLex checks what it connects, where resources belong, and what the relationship says.</p>
      </div>
      <div class="semantic-list">
        <article><span class="semantic-symbol" aria-hidden="true">↳</span><div><h3>Resources with an identity</h3><p>Lambda is a function. DynamoDB is a database. Provider catalogs give each node more than a label.</p></div></article>
        <article><span class="semantic-symbol" aria-hidden="true">⇢</span><div><h3>Relationships with rules</h3><p>“Invokes” and “writes” mean different things. Supported endpoints are checked against provider declarations.</p></div></article>
        <article><span class="semantic-symbol" aria-hidden="true">⊡</span><div><h3>Boundaries that belong</h3><p>Accounts, regions, VPCs, subnets and namespaces describe structure. ArchLex checks supported placement rules.</p></div></article>
      </div>
    </section>

    <section class="diff-section" aria-labelledby="diff-title">
      <div class="shell diff-section__grid">
        <figure class="review-diff">
          <figcaption><span>orders.archlex</span><span>One relationship changed</span></figcaption>
          <pre tabindex="0" aria-label="Architecture source diff"><code><span> api: api-gateway</span>
<span> worker: lambda</span>
<span> data: dynamodb</span>
<span> </span>
<span> api -[invokes]-&gt; worker</span>
<span class="diff-removed">− worker -[invokes]-&gt; data</span>
<span class="diff-added">+ worker -[writes]-&gt; data</span></code></pre>
          <div class="review-diff__result"><span aria-hidden="true">✓</span> A supported connection. A readable change.</div>
        </figure>
        <div class="diff-section__copy">
          <h2 id="diff-title">Small changes.<br />Clear reviews.</h2>
          <p>Your diagram lives in plain text. Review the relationship that changed, keep the source in Git, and render it as SVG.</p>
          <a class="text-link" href={exampleUrl(reviewSources.valid)}>Make your first change <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="coverage-section shell" aria-labelledby="coverage-title">
      <div class="section-intro"><h2 id="coverage-title">The clouds you work in.</h2><p>Provider-aware resources and official icons.<br />Mix providers in one diagram when your architecture does.</p></div>
      <div class="provider-list">
        {providers.map((provider) => (
          <article class="provider-row">
            <h3><a href={exampleUrl(provider.source)}>{provider.name}<span aria-hidden="true">↗</span></a></h3>
            <p>{provider.detail}</p>
            <span class="provider-count">{provider.count}</span>
            <a class="provider-reference" href={provider.docs} aria-label={provider.name + " reference"}>Reference <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="questions-section shell" aria-labelledby="faq-title">
      <h2 id="faq-title">A few useful answers.</h2>
      <div class="questions-list">
        {faqs.map(({ q, a }) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}
      </div>
    </section>

    <section class="closing-section shell" aria-labelledby="closing-title">
      <div><h2 id="closing-title">Your next diagram<br /> starts with a prompt.</h2><p>Bring your agent. The MCP server and playground are ready.</p></div>
      <Button href="#get-started">Connect your agent for free <span aria-hidden="true">↗</span></Button>
    </section>
  </main>
  <SiteFooter />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
