---
import Button from "../components/Button.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Hero from "../components/Hero.astro";
import HeroCompare from "../components/HeroCompare.astro";
import McpShowcase from "../components/McpShowcase.astro";
import PackageQuickStart from "../components/PackageQuickStart.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_ROUTES } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";

const sourceExample = `provider aws
api: api-gateway
worker: lambda
data: dynamodb

api -[invokes]-> worker
worker -[writes]-> data`;

const skillInstallCmd = "npx skills add baires/archlex";

const faqs = [
  {
    q: "What is ArchLex?",
    a: "ArchLex is an open source language and renderer for cloud architecture diagrams as code. You describe AWS, Cloudflare, GCP, or Kubernetes architecture in plain text, ArchLex validates it, and it renders an SVG with official cloud icons.",
  },
  {
    q: "How do I get Claude, Cursor, or Codex to draw an architecture diagram?",
    a: "Install the agent skill with npx skills add baires/archlex, or connect the ArchLex MCP server at https://mcp.archlex.dev/mcp. Then ask your agent to diagram your AWS, Cloudflare, GCP, or Kubernetes setup. The agent writes ArchLex source, ArchLex validates it, and you get back an SVG.",
  },
  {
    q: "Which clouds does ArchLex support?",
    a: "AWS (194 services), GCP (185 services), Cloudflare (92 services), and Kubernetes (62 resources). You can mix providers in one diagram.",
  },
  {
    q: "Do I need an account or API key?",
    a: "No. ArchLex is MIT licensed and runs locally through the CLI and npm packages, in the browser playground, or through the hosted MCP server, with no account or API key.",
  },
  {
    q: "Can I render diagrams without an AI agent?",
    a: "Yes. Write ArchLex in the playground at playground.archlex.dev, render it with the CLI, or call @archlex/core from Node.js or the browser.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<BaseLayout
  title="ArchLex: Cloud Architecture Diagrams as Code for AI Agents"
  description="Open source architecture diagrams as code. Ask Claude, Cursor, or Codex to diagram AWS, Cloudflare, GCP, or Kubernetes and get validated SVG with official cloud icons."
>
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <Hero />
    <HeroCompare />

    <!-- Feature Family 1: Semantic Verification & Diffability (Asymmetric 2-Column Split Grid) -->
    <section class="proof-section shell shell--wide" aria-labelledby="proof-section-title">
      <h2 id="proof-section-title" class="visually-hidden">Semantic Validation and Code Review</h2>
      <div class="proof-grid">
        <article class="proof-card proof-card--visual">
          <div class="proof-card__header">
            <h3>Not just boxes.</h3>
            <p>ArchLex understands cloud resources, boundaries, and typed relationships, not just shapes.</p>
          </div>
          <figure class="semantic-proof">
            <img class="diagram-img diagram-img--dark" src="/diagrams/serverless-api-dark.svg" alt="API Gateway invokes Lambda, which writes to DynamoDB" width="742" height="116" loading="lazy" decoding="async" />
            <img class="diagram-img diagram-img--light" src="/diagrams/serverless-api-light.svg" alt="API Gateway invokes Lambda, which writes to DynamoDB" width="742" height="116" loading="lazy" decoding="async" />
            <figcaption>
              <span class="proof-badge" aria-label="Validated AWS architecture">
                <span class="proof-badge__dot" aria-hidden="true"></span>
                <span>Architecture valid: AWS Serverless</span>
              </span>
            </figcaption>
          </figure>
        </article>

        <article class="proof-card proof-card--diff">
          <div class="proof-card__header">
            <h3>Readable in code review.</h3>
            <p>Concise text source stays clear in diffs. Deterministic, accessible SVG keeps rendered reviews consistent.</p>
          </div>
          <div class="source-proof">
            <div class="source-proof__chrome" aria-hidden="true">
              <span class="source-proof__tag">serverless-api.archlex</span>
            </div>
            <CodeBlock code={sourceExample} lang="archlex" />
          </div>
        </article>
      </div>
    </section>

    <!-- Feature Family 2: Built for AI Agents (Full-Width Interactive MCP Terminal Console) -->
    <section class="mcp-section shell shell--wide" id="mcp" aria-labelledby="mcp-section-title">
      <div class="section-heading">
        <h2 id="mcp-section-title">Built for AI agents.</h2>
      </div>
      <McpShowcase />
    </section>

    <!-- Feature Family 3: Open Agent Skill Matrix (Command Bar + 3-Card Bento Grid) -->
    <section class="skill-section shell shell--wide" id="skill" aria-labelledby="skill-section-title">
      <div class="section-heading">
        <h2 id="skill-section-title">Official agent skill.</h2>
        <p class="section-lead">Equip Claude Code, Cursor, Codex, and any AI coding assistant supporting the open <code>SKILLS.md</code> standard with deep cloud architecture diagramming and semantic validation.</p>
      </div>

      <div class="skill-terminal">
        <div class="skill-terminal__bar">
          <span class="skill-terminal__dot"></span>
          <span class="skill-terminal__title">Agent Skill Install (SKILLS.md)</span>
        </div>
        <div class="skill-terminal__content">
          <code>{skillInstallCmd}</code>
          <button
            type="button"
            class="skill-copy-btn"
            id="skill-copy-trigger"
            data-copy-text={skillInstallCmd}
            aria-label="Copy skill install command"
          >
            <span>Copy command</span>
          </button>
        </div>
        <div class="skill-terminal__meta">
          <span>Compatible with Claude Code, Cursor, Codex, and AGENTS.md / SKILLS.md agents</span>
        </div>
      </div>

      <div class="skill-matrix">
        <div class="skill-card">
          <div class="skill-card__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </div>
          <h3>MCP tool workflows</h3>
          <p>Step-by-step workflow for <code>render_diagram</code>, <code>validate_diagram</code>, and catalog lookups directly within your coding agent session.</p>
        </div>

        <div class="skill-card">
          <div class="skill-card__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <h3>DSL reference &amp; rules</h3>
          <p>Complete syntax rules, relationship kinds, containment scopes (accounts, regions, VPCs, subnets, and Cloudflare root/account placement), and diagnostic resolution.</p>
        </div>

        <div class="skill-card">
          <div class="skill-card__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3>Working templates</h3>
          <p>Production-ready AWS, Cloudflare, GCP, and Kubernetes templates that any AI agent can immediately adapt, validate, and extend.</p>
        </div>
      </div>

      <div class="skill-action-footer">
        <span>Open source SKILLS.md definition</span>
        <a class="text-link" href="https://github.com/baires/archlex/tree/main/.agents/skills/archlex" target="_blank" rel="noopener noreferrer">
          <span>View skill definition on GitHub</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Feature Family 4: Package Ecosystem & Quickstart -->
    <section class="quickstart-section shell shell--wide" id="quickstart" aria-labelledby="quickstart-section-title">
      <div class="section-heading">
        <h2 id="quickstart-section-title">Open source. Embed anywhere.</h2>
        <p class="section-lead">Lightweight, modular packages for browser and Node.js. Zero native binary dependencies.</p>
      </div>
      <PackageQuickStart />
    </section>

    <!-- FAQ -->
    <section class="topic-section shell shell--reading" id="faq" aria-labelledby="faq-title">
      <div class="section-heading">
        <h2 id="faq-title">Questions.</h2>
      </div>
      <dl class="faq-list">
        {faqs.map(({ q, a }) => (
          <div class="faq-item">
            <dt>{q}</dt>
            <dd>{a}</dd>
          </div>
        ))}
      </dl>
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    </section>

    <!-- Feature Family 5: Final CTA -->
    <section class="final-cta shell shell--reading" aria-labelledby="final-cta-title">
      <p class="eyebrow">Open source · MIT licensed · No account required</p>
      <h2 id="final-cta-title">See your architecture clearly.</h2>
      <div class="final-cta__actions">
        <Button href={SITE_ROUTES.playground}>Open playground</Button>
        <Button href={SITE_ROUTES.docs} variant="text">Read the docs <span aria-hidden="true">→</span></Button>
      </div>
    </section>
  </main>
  <SiteFooter />

  <script>
    const skillCopyBtn = document.getElementById("skill-copy-trigger");
    if (skillCopyBtn) {
      skillCopyBtn.addEventListener("click", async () => {
        const text = skillCopyBtn.getAttribute("data-copy-text") || "";
        const originalText = skillCopyBtn.innerHTML;
        try {
          await navigator.clipboard.writeText(text);
          skillCopyBtn.classList.add("is-copied");
          skillCopyBtn.innerHTML = "<span>Copied ✓</span>";
          setTimeout(() => {
            skillCopyBtn.classList.remove("is-copied");
            skillCopyBtn.innerHTML = originalText;
          }, 2000);
        } catch {
          const input = document.createElement("input");
          input.value = text;
          document.body.appendChild(input);
          input.select();
          document.execCommand("copy");
          document.body.removeChild(input);
          skillCopyBtn.classList.add("is-copied");
          skillCopyBtn.innerHTML = "<span>Copied ✓</span>";
          setTimeout(() => {
            skillCopyBtn.classList.remove("is-copied");
            skillCopyBtn.innerHTML = originalText;
          }, 2000);
        }
      });
    }
  </script>
</BaseLayout>
