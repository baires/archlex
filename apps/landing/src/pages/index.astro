---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ProductFrame from '../components/ProductFrame.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SemanticProof from '../components/SemanticProof.astro';
import Capabilities from '../components/Capabilities.astro';
import SourceToSystem from '../components/SourceToSystem.astro';
import QuickStart from '../components/QuickStart.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_ROUTES } from '../config';
---

<BaseLayout
  title="ArchLex — Cloud diagrams that understand your cloud"
  description="Write cloud architecture as concise text. ArchLex validates the semantics and renders deterministic, accessible SVG."
>
  <SiteHeader />
  <main id="main-content">
    <section class="hero shell">
      <div class="hero__copy">
        <p class="eyebrow"><span>OPEN SOURCE</span> AWS + GCP</p>
        <h1>Your cloud diagram should understand your cloud.</h1>
        <p class="hero__lede">
          Write concise infrastructure. ArchLex validates what it means and turns it into an accessible architecture diagram.
        </p>
        <div class="hero__actions">
          <Button href={SITE_ROUTES.playground}>Open playground <span aria-hidden="true">→</span></Button>
          {SITE_ROUTES.github && (
            <Button href={SITE_ROUTES.github} variant="text" external>View on GitHub ↗</Button>
          )}
        </div>
        <ul class="hero__proof" aria-label="Product capabilities">
          <li><span>✓</span> Semantic validation</li>
          <li><span>✓</span> Deterministic SVG</li>
          <li><span>✓</span> Accessible output</li>
        </ul>
      </div>
      <div class="hero__visual">
        <div class="hero__coordinate" aria-hidden="true">SYS.ARCH / 001</div>
        <ProductFrame />
      </div>
    </section>
    <SemanticProof />
    <Capabilities />
    <SourceToSystem />
    <QuickStart />
    <section class="final-cta shell" aria-labelledby="final-cta-title">
      <div class="final-cta__signal" aria-hidden="true">→</div>
      <p class="eyebrow"><span>READY WHEN YOU ARE</span> NO ACCOUNT REQUIRED</p>
      <h2 id="final-cta-title">Your architecture already lives in code. Diagram it there too.</h2>
      <div class="final-cta__actions">
        <Button href={SITE_ROUTES.playground}>Open playground →</Button>
        <Button href={SITE_ROUTES.docs} variant="text">Explore the docs</Button>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
