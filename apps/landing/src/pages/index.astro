---
import Button from "../components/Button.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Hero from "../components/Hero.astro";
import HeroCompare from "../components/HeroCompare.astro";
import McpShowcase from "../components/McpShowcase.astro";
import PackageQuickStart from "../components/PackageQuickStart.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StoryRow from "../components/StoryRow.astro";
import { SITE_ROUTES } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";

const sourceExample = `provider aws
api: api-gateway
worker: lambda
data: dynamodb

api -[invokes]-> worker
worker -[writes]-> data`;
---

<BaseLayout
  title="ArchLex — Cloud diagrams that understand your cloud"
  description="Write cloud architecture as concise text. ArchLex validates the semantics and renders deterministic, accessible SVG."
>
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <Hero />
    <HeroCompare />
    <div class="story-sequence">
      <StoryRow index="01" title="Not just boxes.">
        <p>ArchLex understands cloud resources, boundaries, and typed relationships—not just shapes.</p>
        <figure class="semantic-proof">
          <img class="diagram-img diagram-img--dark" src="/diagrams/serverless-api-dark.svg" alt="API Gateway invokes Lambda, which writes to DynamoDB" width="742" height="116" />
          <img class="diagram-img diagram-img--light" src="/diagrams/serverless-api-light.svg" alt="API Gateway invokes Lambda, which writes to DynamoDB" width="742" height="116" />
          <figcaption><span aria-hidden="true">✓</span> Architecture valid</figcaption>
        </figure>
      </StoryRow>

      <StoryRow index="02" title="Readable in code review.">
        <p>Concise source stays clear in a diff. Deterministic, accessible SVG keeps every rendered review consistent.</p>
        <div class="source-proof">
          <CodeBlock code={sourceExample} lang="archlex" />
        </div>
      </StoryRow>

      <StoryRow index="03" title="Built for AI agents." id="mcp">
        <McpShowcase />
      </StoryRow>

      <StoryRow index="04" title="Open source. Embed anywhere.">
        <PackageQuickStart />
      </StoryRow>

      <StoryRow index="05" title="Official Claude Code skill." id="skill">
        <p>Install the official ArchLex skill for Claude Code to give Claude deep expertise in cloud architecture diagramming, semantic validation, and the ArchLex DSL.</p>
        <div class="skill-install">
          <pre><code>npx skills add baires/archlex</code></pre>
          <p class="skill-meta">Auto-invoked for AWS, GCP, and Kubernetes diagrams</p>
        </div>
        <div class="skill-features">
          <div class="skill-feature">
            <span class="skill-feature-icon" aria-hidden="true">→</span>
            <div>
              <strong>MCP tool guidance</strong>
              <p>Step-by-step workflow for render_diagram, validate_diagram, and catalog lookups</p>
            </div>
          </div>
          <div class="skill-feature">
            <span class="skill-feature-icon" aria-hidden="true">→</span>
            <div>
              <strong>DSL reference</strong>
              <p>Complete syntax rules, relationship kinds, and containment scopes</p>
            </div>
          </div>
          <div class="skill-feature">
            <span class="skill-feature-icon" aria-hidden="true">→</span>
            <div>
              <strong>Working examples</strong>
              <p>AWS, GCP, and Kubernetes templates to start from</p>
            </div>
          </div>
          <div class="skill-features-footer">
            <p>Open source skill definition for Claude Code</p>
            <a class="text-link" href="https://github.com/baires/archlex/tree/main/.agents/skills/archlex" target="_blank" rel="noopener noreferrer">View source <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </StoryRow>
    </div>

    <section class="final-cta shell shell--reading" aria-labelledby="final-cta-title">
      <p class="eyebrow">Open source · MIT licensed · No account required</p>
      <h2 id="final-cta-title">See your architecture clearly.</h2>
      <div class="final-cta__actions">
        <Button href={SITE_ROUTES.playground}>Open playground</Button>
        <Button href={SITE_ROUTES.docs} variant="text">Read the docs <span aria-hidden="true">→</span></Button>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
