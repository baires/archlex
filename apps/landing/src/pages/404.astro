---
import Button from "../components/Button.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_ROUTES } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | ArchLex" noindex>
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <section class="final-cta shell shell--reading" aria-labelledby="not-found-title">
      <p class="eyebrow">404</p>
      <h1 id="not-found-title">Page not found.</h1>
      <div class="final-cta__actions">
        <Button href="/">Go home</Button>
        <Button href={SITE_ROUTES.docs} variant="text">Read the docs <span aria-hidden="true">→</span></Button>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
