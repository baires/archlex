---
interface Props {
  code: string;
  lang?: string;
}
const { code, lang = "archlex" } = Astro.props;
---
<div class="code-block" data-lang={lang}>
  <pre tabindex="0" aria-label={lang + " source"}><code>{code}</code></pre>
</div>

<style>
  .code-block { min-width: 0; width: 100%; }
  pre { margin: 0; padding: var(--space-5); border-radius: var(--radius-code); background: var(--surface-canvas); }
  code { font-family: var(--font-code); color: var(--text-primary); font-size: .8125rem; line-height: 1.8; }
</style>
