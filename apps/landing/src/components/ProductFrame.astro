---
interface Props {
  variant?: 'hero' | 'source-to-system';
}

const { variant = 'hero' } = Astro.props;

const heroSource = `direction LR
provider aws
validation normal

account global-core {
  region us-east-1 {
    vpc primary-vpc {
      subnet app-subnet-1 {
        app_primary: ecs
        db_primary: rds
      }
    }
  }
}`;

const systemSource = `direction LR
provider aws
validation normal

ingress_api: api-gateway
ingest_fn: lambda
events_bus: eventbridge
notification_topic: sns
buffer_queue: sqs
processor_fn: lambda
lake: s3
nosql_store: dynamodb

ingress_api -[invokes]-> ingest_fn
ingest_fn -[publishes]-> notification_topic
notification_topic -[forwards]-> buffer_queue
events_bus -[triggers]-> buffer_queue
buffer_queue -[batch_invokes]-> processor_fn
processor_fn -[persists]-> nosql_store
processor_fn -[archives]-> lake`;

const source = variant === 'source-to-system' ? systemSource : heroSource;
const image = variant === 'source-to-system'
  ? '/archlex-event-pipeline-dark.png'
  : '/archlex-multi-region-dark.png';
const alt = variant === 'source-to-system'
  ? 'AWS event pipeline architecture rendered by ArchLex'
  : 'Multi-region AWS architecture rendered by ArchLex';
---

<div class:list={['product-frame', `product-frame--${variant}`]}>
  <div class="product-frame__bar">
    <span><i aria-hidden="true"></i> ARCHLEX / PLAYGROUND</span>
    <span class="product-frame__status">READY · VALID</span>
  </div>
  <div class="product-frame__workspace">
    <div class="product-frame__source">
      <div class="pane-label"><span>01</span> SOURCE</div>
      <pre><code>{source}</code></pre>
    </div>
    <figure class="product-frame__render">
      <div class="pane-label"><span>02</span> RENDER</div>
      <img
        src={image}
        alt={alt}
        width="864"
        height="826"
      />
      <figcaption>Provider-aware layout · deterministic SVG</figcaption>
    </figure>
  </div>
</div>
