---
interface Props {
  variant?: 'hero' | 'source-to-system';
}

const { variant = 'hero' } = Astro.props;

const source = `direction LR
provider aws
validation normal

account global-core {
  region us-east-1 {
    vpc primary-vpc {
      subnet app-subnet-1 {
        app_primary: ecs
        db_primary: rds
      }
    }
  }
}`;
---

<div class:list={['product-frame', `product-frame--${variant}`]}>
  <div class="product-frame__bar">
    <span><i aria-hidden="true"></i> ARCHLEX / PLAYGROUND</span>
    <span class="product-frame__status">READY · VALID</span>
  </div>
  <div class="product-frame__workspace">
    <div class="product-frame__source">
      <div class="pane-label"><span>01</span> SOURCE</div>
      <pre><code>{source}</code></pre>
    </div>
    <figure class="product-frame__render">
      <div class="pane-label"><span>02</span> RENDER</div>
      <img
        src="/archlex-multi-region-dark.png"
        alt="Multi-region AWS architecture rendered by ArchLex"
        width="864"
        height="826"
      />
      <figcaption>Provider-aware layout · deterministic SVG</figcaption>
    </figure>
  </div>
</div>
