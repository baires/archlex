---
interface Props {
  variant?: "hero" | "source-to-system";
}

const { variant = "hero" } = Astro.props;

const heroSource = `direction LR
provider aws
validation normal

account global-core {
  region us-east-1 {
    vpc primary-vpc {
      subnet app-subnet-1 {
        app_primary: ecs
        db_primary: rds
      }
    }
  }
}`;

const systemSource = `direction LR
provider aws
validation normal

ingress_api: api-gateway
ingest_fn: lambda
events_bus: eventbridge
notification_topic: sns
buffer_queue: sqs
processor_fn: lambda
lake: s3
nosql_store: dynamodb

ingress_api -[invokes]-> ingest_fn
ingest_fn -[publishes]-> notification_topic
notification_topic -[forwards]-> buffer_queue
events_bus -[triggers]-> buffer_queue
buffer_queue -[batch_invokes]-> processor_fn
processor_fn -[persists]-> nosql_store
processor_fn -[archives]-> lake`;

const source = variant === "source-to-system" ? systemSource : heroSource;
---

{variant === "hero" ? (
  <figure class="hero-diagram">
    <img
      src="/diagrams/multi-region.svg"
      alt="Multi-region cloud architecture rendered by ArchLex"
      width="1501"
      height="535"
    />
    <figcaption>
      <span>Two regions</span>
      <span>Typed failover and replication</span>
    </figcaption>
  </figure>
) : (
  <div class="product-frame product-frame--source-to-system">
    <div class="product-frame__workspace">
      <div class="product-frame__source">
        <div class="pane-label">Source</div>
        <pre><code>{source}</code></pre>
      </div>
      <figure class="product-frame__render">
        <div class="pane-label">Diagram</div>
        <img
          src="/diagrams/event-pipeline.svg"
          alt="AWS event pipeline architecture rendered by ArchLex"
          width="1114"
          height="538"
        />
        <figcaption>Same source. Same SVG. Every time.</figcaption>
      </figure>
    </div>
  </div>
)}
