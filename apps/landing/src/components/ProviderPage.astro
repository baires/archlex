---
import { SITE_ROUTES } from "../config";
import {
  diagramUrl,
  type ExampleProvider,
  examplesFor,
  publishedExamples,
  renderExample,
} from "../data/examples";
import { providerPage, providerPages, providerPath } from "../data/providers";
import { breadcrumbJsonLd, faqJsonLd } from "../data/seo";
import { servicePath, servicesFor } from "../data/services";
import { exampleUrl } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import Button from "./Button.astro";
import CodeBlock from "./CodeBlock.astro";
import ExampleCards from "./ExampleCards.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  provider: ExampleProvider;
}

const page = providerPage(Astro.props.provider);
const path = providerPath(page);
const id = page.slug;

let featured: {
  title: string;
  lead: string;
  file: string;
  source: string;
  light: string;
  dark: string;
  alt: string;
  width: number;
  height: number;
  href?: string;
};
if (page.featuredStatic) {
  featured = page.featuredStatic;
} else {
  const example = publishedExamples.find(
    (item) => item.id === page.featuredExampleId,
  );
  if (!example)
    throw new Error(`Featured example ${page.featuredExampleId} not found.`);
  const { width, height } = await renderExample(example.source, "light");
  featured = {
    title: `${example.title}.`,
    lead: `${example.description}.`,
    file: `${example.id}.arch`,
    source: example.source,
    light: diagramUrl(example.id, "light"),
    dark: diagramUrl(example.id, "dark"),
    alt: `${page.name} architecture diagram: ${example.description}`,
    width,
    height,
    href: example.path,
  };
}

const examples = examplesFor(page.provider).filter(
  (item) => item.id !== page.featuredExampleId,
);
const otherProviders = providerPages.filter((item) => item.slug !== page.slug);
const serviceLinks = servicesFor(page.provider);
const crumbs = [
  { name: "ArchLex", path: "/" },
  { name: `${page.name} architecture diagrams`, path },
];
const cliCode = `npx @archlex/cli render ${featured.file} --output ${featured.file.replace(/\.arch$/, ".svg")}`;
const skillInstallCmd = "npx skills add baires/archlex";
---

<BaseLayout
  title={page.title}
  description={page.description}
  jsonLd={[faqJsonLd(page.faqs), breadcrumbJsonLd(crumbs)]}
>
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <Breadcrumbs crumbs={crumbs} />
    <section class="hero topic-hero shell shell--reading" aria-labelledby={`${id}-title`}>
      <div class="hero__copy">
        <p class="eyebrow">{page.name} · Open source · No account required</p>
        <h1 id={`${id}-title`}>{page.h1}</h1>
        <p class="hero__lede">{page.lede}</p>
        <div class="hero__actions">
          <Button href={exampleUrl(featured.source)}>Try it in the playground</Button>
          <Button href={page.docs.href} variant="text">{page.docs.label} <span aria-hidden="true">→</span></Button>
        </div>
      </div>
    </section>

    <section class="topic-section shell shell--wide" aria-labelledby={`${id}-example-title`}>
      <div class="section-heading">
        <h2 id={`${id}-example-title`}>{featured.title}</h2>
        <p class="section-lead">{featured.lead}</p>
      </div>
      <div class="topic-stack">
        <article class="proof-card proof-card--visual">
          <figure class="semantic-proof">
            <img class="diagram-img diagram-img--dark" src={featured.dark} alt={featured.alt} width={featured.width} height={featured.height} loading="lazy" decoding="async" />
            <img class="diagram-img diagram-img--light" src={featured.light} alt={featured.alt} width={featured.width} height={featured.height} loading="lazy" decoding="async" />
          </figure>
        </article>
        <article class="proof-card proof-card--diff">
          <div class="source-proof">
            <div class="source-proof__chrome" aria-hidden="true">
              <span class="source-proof__tag">{featured.file}</span>
            </div>
            <CodeBlock code={featured.source} lang="archlex" />
          </div>
        </article>
      </div>
      {featured.href && <p class="section-lead"><a class="text-link" href={featured.href}>See this example in the gallery <span aria-hidden="true">→</span></a></p>}
    </section>

    <section class="topic-section shell shell--reading" aria-labelledby={`${id}-why-title`}>
      <div class="section-heading">
        <h2 id={`${id}-why-title`}>Why write {page.name} diagrams as code?</h2>
      </div>
      <ul class="topic-list">
        {page.why.map((item) => <li><strong>{item.title}</strong> {item.body}</li>)}
      </ul>
    </section>

    {examples.length > 0 && (
      <section class="topic-section shell shell--wide" aria-labelledby={`${id}-examples-title`}>
        <div class="section-heading">
          <h2 id={`${id}-examples-title`}>More {page.name} architecture examples.</h2>
          <p class="section-lead">Each example passes ArchLex provider checks and opens in the playground. <a class="text-link" href="/examples/">Browse all examples</a>.</p>
        </div>
        <ExampleCards examples={examples} />
      </section>
    )}

    <section class="topic-section shell shell--reading" aria-labelledby={`${id}-agents-title`}>
      <div class="section-heading">
        <h2 id={`${id}-agents-title`}>Let your AI agent draw it.</h2>
        <p class="section-lead">Install the ArchLex skill or connect the MCP server, then ask Claude, Cursor, or Codex to diagram your {page.name} setup. The agent writes the source, ArchLex validates it, and you get back an SVG.</p>
      </div>
      <div class="skill-terminal">
        <div class="skill-terminal__bar">
          <span class="skill-terminal__dot"></span>
          <span class="skill-terminal__title">Agent skill install</span>
        </div>
        <div class="skill-terminal__content">
          <code>{skillInstallCmd}</code>
        </div>
      </div>
      <p class="section-lead">Prefer MCP? Follow the <a class="text-link" href={SITE_ROUTES.mcpDocs}>MCP server guide</a>.</p>
    </section>

    <section class="topic-section shell shell--reading" aria-labelledby={`${id}-cli-title`}>
      <div class="section-heading">
        <h2 id={`${id}-cli-title`}>Render from the command line.</h2>
        <p class="section-lead">Save the source as a <code>.arch</code> file and render it with the CLI, or call <code>@archlex/core</code> from Node.js or the browser.</p>
      </div>
      <CodeBlock code={cliCode} lang="bash" />
    </section>

    <section class="questions-section shell shell--reading" aria-labelledby={`${id}-faq-title`}>
      <h2 id={`${id}-faq-title`}>{page.name} diagram questions.</h2>
      <div class="questions-list">
        {page.faqs.map(({ q, a }) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}
      </div>
    </section>


    {serviceLinks.length > 0 && (
      <section class="topic-section shell shell--reading" aria-labelledby={`${id}-services-title`}>
        <div class="section-heading">
          <h2 id={`${id}-services-title`}>{page.name} service architecture diagrams.</h2>
          <p class="section-lead">Focused pages for high-search services, each with validated ArchLex source and SVG.</p>
        </div>
        <ul class="topic-links">
          {serviceLinks.map((item) => <li><a class="text-link" href={servicePath(item)}>{item.name} architecture diagram</a></li>)}
        </ul>
      </section>
    )}

    <section class="topic-section shell shell--reading" aria-labelledby={`${id}-more-title`}>
      <div class="section-heading">
        <h2 id={`${id}-more-title`}>Other clouds.</h2>
        <p class="section-lead">Mix providers in one diagram when your architecture does.</p>
      </div>
      <ul class="topic-links">
        {otherProviders.map((item) => <li><a class="text-link" href={providerPath(item)}>{item.name} architecture diagrams</a></li>)}
        <li><a class="text-link" href="/examples/">Architecture diagram examples</a></li>
      </ul>
    </section>

    <section class="final-cta shell shell--reading" aria-labelledby={`${id}-cta-title`}>
      <p class="eyebrow">Open source · MIT licensed</p>
      <h2 id={`${id}-cta-title`}>Diagram your {page.name} architecture.</h2>
      <div class="final-cta__actions">
        <Button href={SITE_ROUTES.playground}>Open playground</Button>
        <Button href="https://docs.archlex.dev/getting-started/" variant="text">Get started <span aria-hidden="true">→</span></Button>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
