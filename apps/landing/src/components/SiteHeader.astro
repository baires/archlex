---
import { SITE_ROUTES } from "../config";
import Button from "./Button.astro";
import ThemeControl from "./ThemeControl.astro";
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href="/" aria-label="ArchLex home">
      <span class="wordmark__mark" aria-hidden="true">A/</span>
      <span>ARCHLEX</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href={SITE_ROUTES.docs}>Docs</a>
      {SITE_ROUTES.github && (
        <a href={SITE_ROUTES.github} target="_blank" rel="noreferrer">GitHub</a>
      )}
      <ThemeControl />
      <Button href={SITE_ROUTES.playground}>Playground <span aria-hidden="true">↗</span></Button>
    </nav>
  </div>
</header>
