---
import Button from './Button.astro';
import { SITE_ROUTES } from '../config';
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href="/" aria-label="ArchLex home">
      <span class="wordmark__mark" aria-hidden="true">A/</span>
      <span>ARCHLEX</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href={SITE_ROUTES.docs}>Docs</a>
      {SITE_ROUTES.github && (
        <a href={SITE_ROUTES.github} target="_blank" rel="noreferrer">GitHub</a>
      )}
      <Button href={SITE_ROUTES.playground} variant="secondary" class="site-nav__cta">
        Playground <span aria-hidden="true">↗</span>
      </Button>
    </nav>
  </div>
</header>
