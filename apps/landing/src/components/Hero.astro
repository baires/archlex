---
import { SITE_ROUTES } from "../config";
import Button from "./Button.astro";
---
<section class="hero shell shell--reading" aria-labelledby="hero-title">
  <div class="hero__copy">
    <p class="eyebrow">Open source · Claude, Cursor, Codex</p>
    <h1 id="hero-title">Diagrams that know what they mean.</h1>
    <p class="hero__lede">Ask your agent to diagram AWS, GCP, or Kubernetes. ArchLex validates the architecture and renders official-icon SVG you can read, diff, and share.</p>
    <div class="hero__actions">
      <Button href="#skill">Install agent skill</Button>
      <Button href="#mcp" variant="text">Connect MCP <span aria-hidden="true">→</span></Button>
    </div>
  </div>
</section>
