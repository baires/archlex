---
import { SITE_ROUTES } from "../config";
import Button from "./Button.astro";
---
<section class="hero shell shell--reading" aria-labelledby="hero-title">
  <div class="hero__copy">
    <p class="eyebrow">Open source cloud architecture</p>
    <h1 id="hero-title">Diagrams that know what they mean.</h1>
    <p class="hero__lede">Write cloud architecture as text. ArchLex validates semantics with AWS, GCP, and Kubernetes knowledge—then renders trustworthy SVG diagrams. Built for agents and humans.</p>
    <div class="hero__actions">
      <Button href={SITE_ROUTES.playground}>Open playground</Button>
      <Button href="#mcp" variant="text">Agent integration <span aria-hidden="true">→</span></Button>
    </div>
  </div>
</section>
