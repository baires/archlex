{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archlex-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "RENDER_URL_TTL_SECONDS": "600",
    "RENDER_URL_MAX_LENGTH": "7500",
    "SHARE_ORIGIN": "https://share.archlex.dev",
    "PLAYGROUND_ORIGIN": "https://playground.archlex.dev"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "260923101",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
