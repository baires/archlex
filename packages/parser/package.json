{
  "name": "@archlex/parser",
  "version": "0.6.1",
  "description": "ArchLex DSL parser for architecture diagrams",
  "keywords": ["architecture", "diagrams", "parser", "dsl", "language"],
  "repository": {
    "type": "git",
    "url": "https://github.com/baires/archlex.git",
    "directory": "packages/parser"
  },
  "license": "MIT",
  "author": "Alexis Sgarbossa",
  "type": "module",
  "main": "./dist/index.js",
