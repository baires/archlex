{
  "name": "@archlex/core",
  "version": "0.3.2",
  "description": "Core architecture diagramming engine for cloud infrastructure",
  "keywords": [
    "architecture",
    "diagrams",
    "cloud",
    "aws",
    "gcp",
    "infrastructure"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baires/archlex.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Alexis Sgarbossa",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@archlex/aws": "workspace:^",
    "@archlex/diagnostics": "workspace:^",
    "@archlex/gcp": "workspace:^",
    "@archlex/icons-core": "workspace:^",
    "@archlex/k8s": "workspace:^",
    "@archlex/layout-elk": "workspace:^",
    "@archlex/model": "workspace:^",
    "@archlex/parser": "workspace:^",
    "@archlex/renderer-svg": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
