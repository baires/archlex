{
  "name": "@archlex/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@archlex/aws": "workspace:^",
    "@archlex/diagnostics": "workspace:^",
    "@archlex/gcp": "workspace:^",
    "@archlex/layout-elk": "workspace:^",
    "@archlex/model": "workspace:^",
    "@archlex/parser": "workspace:^",
    "@archlex/renderer-svg": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
