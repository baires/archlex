{
  "name": "@archlex/icons",
  "version": "0.2.1",
  "description": "Icon loading and manipulation utilities for ArchLex (Node.js)",
  "keywords": [
    "architecture",
    "diagrams",
    "icons",
    "svg",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/archlex/archlex.git",
    "directory": "packages/icons"
  },
  "license": "MIT",
  "author": "Alexis Sgarbossa",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@archlex/icons-core": "workspace:*",
    "@archlex/icons-node": "workspace:*",
    "@xmldom/xmldom": "0.9.10"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
