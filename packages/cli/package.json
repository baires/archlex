{
  "name": "@archlex/cli",
  "version": "0.2.1",
  "description": "Command-line interface for ArchLex architecture diagrams",
  "keywords": ["architecture", "diagrams", "cli", "cloud", "aws", "gcp"],
  "repository": {
    "type": "git",
    "url": "https://github.com/archlex/archlex.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Alexis Sgarbossa",
  "type": "module",
  "bin": {
    "archlex": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run --passWithNoTests",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@archlex/aws": "workspace:*",
    "@archlex/core": "workspace:^",
    "@archlex/diagnostics": "workspace:*",
    "@archlex/gcp": "workspace:*",
    "@archlex/model": "workspace:^",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
